# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELTONIKA_WEBHOOK_SECRET: Optional shared secret header (x-teltonika-secret) for real Teltonika AVL gateway webhooks.
TELTONIKA_WEBHOOK_SECRET=""

# BLOCKCHAIN_RPC_URL: Optional EVM JSON-RPC URL (e.g., Polygon Amoy, Polygon PoS, Base) for live on-chain ESG certificate anchoring.
# BLOCKCHAIN_PRIVATE_KEY: Optional 0x-prefixed EVM signer key for live on-chain calldata anchoring.
# BLOCKCHAIN_EXPLORER_URL: Optional block explorer base URL (default: https://amoy.polygonscan.com).
BLOCKCHAIN_RPC_URL=""
BLOCKCHAIN_PRIVATE_KEY=""
BLOCKCHAIN_EXPLORER_URL="https://amoy.polygonscan.com"

# PATCH_API_KEY / CNAUGHT_API_KEY: Optional carbon credit registry API keys for live Verra/Gold Standard credit retirement orders.
PATCH_API_KEY=""
CNAUGHT_API_KEY=""
